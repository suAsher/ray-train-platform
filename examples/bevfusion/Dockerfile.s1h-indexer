ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

WORKDIR /opt/bevfusion
COPY mmdet3d /opt/bevfusion/mmdet3d
COPY nuscenes_converter.py /opt/bevfusion/tools/data_converter/nuscenes_converter.py

WORKDIR /opt/raytrain-indexer
COPY generate_s1h_public_indexes.py /opt/raytrain-indexer/generate_s1h_public_indexes.py
COPY build_s1h_trusted_index.py /opt/raytrain-indexer/build_s1h_trusted_index.py
COPY raytrain_publisher /opt/raytrain-indexer/raytrain_publisher

ENV PYTHONPATH=/opt/raytrain-indexer:/opt/bevfusion \
    PYTHONUNBUFFERED=1

# The index builder only reads metadata and point-file attributes. It never
# needs root privileges or a GPU device.
USER 1000:1000
