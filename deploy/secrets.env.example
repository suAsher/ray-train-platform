# 仅作为 bootstrap-secrets.sh 的输入模板；复制到受保护路径并 chmod 600。
# 不要将填好的文件提交、上传或粘贴到聊天中。

# 所有环境都必须提供
DATABASE_URL='postgres://platform:CHANGE_ME@postgres.ray-train-platform.svc.cluster.local:5432/platform?sslmode=disable'
PAT_PEPPER='replace-with-at-least-32-random-bytes'
BOOTSTRAP_ADMIN_PASSWORD='replace-with-a-strong-initial-password'

# postgres.mode=standalone 时必须提供；external 时不需要。
POSTGRES_USER='platform'
POSTGRES_PASSWORD='replace-with-a-strong-database-password'

# 仅启用 TOS 控制面浏览/产物上传时填写。不要在训练镜像或 Profile 中写 AK/SK。
# TOS_ACCESS_KEY=''
# TOS_SECRET_KEY=''
# TOS_SECURITY_TOKEN=''

# 仅当 Profile 的 global.imagePullSecrets 配置了私有仓库 Secret 时填写。
# bootstrap-secrets.sh 会在平台 namespace 创建该 Secret；平台在创建租户
# namespace 时自动复制受平台管理的同名 Secret。不要将真实机器人密码提交或粘贴到聊天中。
# REGISTRY_SERVER='harbor.wellspiking.ai'
# REGISTRY_USERNAME='robot$ray-train'
# REGISTRY_PASSWORD='replace-with-a-registry-robot-token'
# 当 Profile 恰好配置一个 imagePullSecret 时可省略；多个时必须显式指定。
# REGISTRY_SECRET_NAME='harbor-registry'
