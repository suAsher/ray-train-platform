# Overlay quickstart.yaml with real images/digests and these HA settings.
release:
  requireImageDigests: true
backend:
  appEnv: production
  replicaCount: 2
postgres:
  mode: external
availability:
  pdbEnabled: true
  minAvailable: 1
ingress:
  enabled: true
  className: nginx
  host: training.example.com
  tls:
    - secretName: raytrain-tls
      hosts: [training.example.com]
