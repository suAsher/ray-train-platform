# Code-free CUDA 12.6 foundation. Explicit-only build target, never a default.
# NVIDIA CUDA 12.6.3 devel, Ubuntu 22.04, linux/amd64. Preserve driver guards.
# Fixed wheels missing from the normal PyPI mirror. Official hashes are
# checked by both BuildKit downloads and pip; never copied into final layers.
FROM scratch AS official-wheels
ADD --checksum=sha256:a4d6d5e9a3d1879a97c08ded0c797579b7965eafd0f0c26c30b45ccc06db939b https://files.pythonhosted.org/packages/57/5c/f8fc0eb2de03464a557d5a4d0c15e972d73362414696618833b771f7eddd/pyarrow-25.0.1-cp310-cp310-manylinux_2_28_x86_64.whl /wheels/pyarrow-25.0.1-cp310-cp310-manylinux_2_28_x86_64.whl
