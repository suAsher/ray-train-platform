ARG GO_BUILDER_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/golang:1.25-alpine@sha256:a9316ea600fe38d4527999823d67764dbd5b5ce4b4a0895266faf0134aa28264
ARG NGINX_RUNTIME_IMAGE=nginxinc/nginx-unprivileged:1.31-alpine
FROM ${GO_BUILDER_IMAGE} AS builder

# See backend/Dockerfile: the internal Go mirror can omit this from image
# metadata even though the compiler is present at /usr/local/go/bin.
ENV PATH=/usr/local/go/bin:$PATH

ARG GOPROXY=https://goproxy.cn,direct
ARG APK_MIRROR=https://repo.huaweicloud.com/repository/alpine
ARG SPK_RAYJOB_VERSION=dev

WORKDIR /src

RUN alpine_version="$(cut -d. -f1-2 /etc/alpine-release)" \
  && printf '%s/v%s/main\n%s/v%s/community\n' "$APK_MIRROR" "$alpine_version" "$APK_MIRROR" "$alpine_version" > /etc/apk/repositories \
  && apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go env -w GOPROXY="${GOPROXY}" && go mod download

COPY . .
RUN mkdir -p /out \
  && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X ray-train-platform-backend/spkrayjob.Version=${SPK_RAYJOB_VERSION}" -o /out/spk-rayjob-linux-amd64 ./cmd/spk-rayjob \
  && CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags="-s -w -X ray-train-platform-backend/spkrayjob.Version=${SPK_RAYJOB_VERSION}" -o /out/spk-rayjob-darwin-arm64 ./cmd/spk-rayjob \
  && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags="-s -w -X ray-train-platform-backend/spkrayjob.Version=${SPK_RAYJOB_VERSION}" -o /out/spk-rayjob-windows-amd64.exe ./cmd/spk-rayjob \
  && cd /out && sha256sum spk-rayjob-* > SHA256SUMS

FROM ${NGINX_RUNTIME_IMAGE} AS release

USER root

COPY --from=builder /out/ /usr/share/nginx/html/downloads/spk-rayjob/
COPY spk-rayjob-nginx.conf /etc/nginx/conf.d/default.conf

RUN sed -i -E 's#^pid[[:space:]]+.*;#pid        /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
  && sed -i -E 's#^error_log.*#error_log /dev/stderr warn;#' /etc/nginx/nginx.conf \
  && sed -i -E 's#^    access_log.*#    access_log /dev/stdout;#' /etc/nginx/nginx.conf \
  && mkdir -p /var/cache/nginx /var/run \
  && chown -R nginx:nginx /var/cache/nginx /var/run /usr/share/nginx/html /etc/nginx

USER nginx

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
