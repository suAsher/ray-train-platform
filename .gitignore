# Dependencies and build output
node_modules/
frontend/dist/
backend/bin/
output/
__pycache__/
*.pyc
.pytest_cache/
.coverage

# Editor / OS noise
.DS_Store
*.orig
*.bak
*.new
.tmp
.claude/settings.local.json

# Local databases and scratch state
*.db
.superpowers/

# Never commit environment-specific values or credentials.
# values.yaml holds only placeholders; per-environment overrides stay local.
helm/ray-train-platform/values-*.yaml
!helm/ray-train-platform/values-test.yaml.example

# Standard deployment keeps environment configuration in deploy/profiles but
# never commits credentials or an operator's private environment override.
deploy/secrets.env
deploy/profiles/*.local.yaml
deploy/profiles/*-private.yaml
deploy/release-records/
