discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "platform_pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_platform_job_id"]
    target_label  = "platform_job_id"
    action        = "replace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_platform_tenant_id"]
    target_label  = "platform_tenant_id"
    action        = "replace"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.platform_pods.output
  forward_to = [loki.write.platform.receiver]
  clustering {
    enabled = true
  }
}

loki.write "platform" {
  endpoint {
    url = "http://loki-gateway.loki.svc.cluster.local/loki/api/v1/push"
  }
}
