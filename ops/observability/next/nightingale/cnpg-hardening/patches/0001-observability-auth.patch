diff --git a/pkg/observabilityauth/metrics.go b/pkg/observabilityauth/metrics.go
new file mode 100644
--- /dev/null
+++ b/pkg/observabilityauth/metrics.go
@@ -0,0 +1,80 @@
+// Package observabilityauth contains the authentication policy for the dedicated
+// observability CloudNativePG deployment. It is deliberately not a general policy API.
+package observabilityauth
+
+import (
+	"bytes"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"fmt"
+	"os"
+	"strings"
+)
+
+const metricsClientURI = "spiffe://observability.raytrain.local/observability-metrics/vmagent"
+
+// NewMetricsTLSConfig preserves the instance's server certificate callback and
+// requires the single reviewed scraping identity. Trust is loaded at startup:
+// changing the projected CA requires a controlled instance-manager restart.
+func NewMetricsTLSConfig(base *tls.Config, caPath, allowedURIs string) (*tls.Config, error) {
+	if base == nil || strings.TrimSpace(caPath) == "" {
+		return nil, fmt.Errorf("metrics TLS configuration and public CA file are required")
+	}
+	if allowedURIs != metricsClientURI {
+		return nil, fmt.Errorf("metrics client URI must be the reviewed vmagent identity")
+	}
+	caPEM, err := os.ReadFile(caPath)
+	if err != nil {
+		return nil, fmt.Errorf("reading metrics client CA: %w", err)
+	}
+	pool, err := metricsCAPool(caPEM)
+	if err != nil {
+		return nil, err
+	}
+	config := base.Clone()
+	config.MinVersion = tls.VersionTLS13
+	config.ClientAuth = tls.RequireAndVerifyClientCert
+	config.ClientCAs = pool
+	previousVerify := base.VerifyConnection
+	config.VerifyConnection = func(state tls.ConnectionState) error {
+		if len(state.VerifiedChains) == 0 || len(state.PeerCertificates) == 0 {
+			return fmt.Errorf("verified metrics client certificate required")
+		}
+		leaf := state.PeerCertificates[0]
+		if len(leaf.URIs) != 1 || leaf.URIs[0].String() != metricsClientURI {
+			return fmt.Errorf("metrics client identity is not authorized")
+		}
+		if previousVerify != nil {
+			return previousVerify(state)
+		}
+		return nil
+	}
+	return config, nil
+}
+
+func metricsCAPool(data []byte) (*x509.CertPool, error) {
+	pool := x509.NewCertPool()
+	count := 0
+	for len(bytes.TrimSpace(data)) > 0 {
+		data = bytes.TrimSpace(data)
+		if !bytes.HasPrefix(data, []byte("-----BEGIN CERTIFICATE-----")) {
+			return nil, fmt.Errorf("unexpected data in metrics client CA bundle")
+		}
+		block, rest := pem.Decode(data)
+		if block == nil || block.Type != "CERTIFICATE" || len(block.Headers) != 0 {
+			return nil, fmt.Errorf("metrics client CA must contain only PEM CA certificates")
+		}
+		cert, err := x509.ParseCertificate(block.Bytes)
+		if err != nil || !cert.IsCA || !cert.BasicConstraintsValid {
+			return nil, fmt.Errorf("invalid metrics client CA certificate")
+		}
+		pool.AddCert(cert)
+		count++
+		data = rest
+	}
+	if count == 0 {
+		return nil, fmt.Errorf("metrics client CA bundle is empty")
+	}
+	return pool, nil
+}
diff --git a/pkg/observabilityauth/webhook.go b/pkg/observabilityauth/webhook.go
new file mode 100644
--- /dev/null
+++ b/pkg/observabilityauth/webhook.go
@@ -0,0 +1,96 @@
+package observabilityauth
+
+import (
+	"fmt"
+	"net"
+	"net/http"
+	"net/netip"
+	"strconv"
+	"strings"
+
+	"sigs.k8s.io/controller-runtime/pkg/webhook"
+)
+
+// WebhookServer puts the source check outside the entire admission mux. A
+// separate upstream registration object retains the upstream per-route metrics
+// instrumentation. Only DefaultServer runs a listener and certificate watcher.
+type WebhookServer struct {
+	*webhook.DefaultServer
+	registration webhook.Server
+	mux          *http.ServeMux
+}
+
+// NewWebhookServer constructs the dedicated observability admission server.
+func NewWebhookServer(options webhook.Options, allowedIPs string) (*WebhookServer, error) {
+	routes := http.NewServeMux()
+	handler, err := NewWebhookHandler(routes, allowedIPs)
+	if err != nil {
+		return nil, err
+	}
+	outer := http.NewServeMux()
+	outer.Handle("/", handler)
+	options.WebhookMux = outer
+	return &WebhookServer{
+		DefaultServer: webhook.NewServer(options).(*webhook.DefaultServer),
+		registration: webhook.NewServer(webhook.Options{WebhookMux: routes}),
+		mux:          routes,
+	}, nil
+}
+
+// Register keeps admission handlers behind the transport's source guard.
+func (s *WebhookServer) Register(path string, handler http.Handler) {
+	s.registration.Register(path, handler)
+}
+
+// WebhookMux also returns the guarded inner mux, so direct registrations such as
+// the upstream readiness probe cannot accidentally bypass the transport guard.
+func (s *WebhookServer) WebhookMux() *http.ServeMux { return s.mux }
+
+// NewWebhookHandler authenticates the actual TCP peer, never forwarded headers.
+// Kubernetes admission is server TLS with an explicit control-plane exception,
+// not mutual TLS. Only GET /readyz is public and returns fixed, minimal text.
+func NewWebhookHandler(next http.Handler, allowedIPs string) (http.Handler, error) {
+	if next == nil {
+		return nil, fmt.Errorf("webhook handler is required")
+	}
+	allowed, err := webhookSourcePolicy(allowedIPs)
+	if err != nil {
+		return nil, err
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodGet && r.URL.Path == "/readyz" {
+			w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+			_, _ = fmt.Fprint(w, "ok\n")
+			return
+		}
+		host, port, splitErr := net.SplitHostPort(r.RemoteAddr)
+		peer, parseErr := netip.ParseAddr(host)
+		portNumber, portErr := strconv.ParseUint(port, 10, 16)
+		if splitErr != nil || parseErr != nil || portErr != nil || portNumber == 0 ||
+			peer.Zone() != "" || !allowed[peer.Unmap()] {
+			http.Error(w, "forbidden", http.StatusForbidden)
+			return
+		}
+		next.ServeHTTP(w, r)
+	}), nil
+}
+
+func webhookSourcePolicy(value string) (map[netip.Addr]bool, error) {
+	reviewed := map[netip.Addr]bool{
+		netip.MustParseAddr("172.28.2.64"): true,
+		netip.MustParseAddr("172.28.5.50"): true,
+	}
+	parts := strings.Split(value, ",")
+	if len(parts) != len(reviewed) {
+		return nil, fmt.Errorf("webhook source policy requires the two reviewed API server IPs")
+	}
+	allowed := make(map[netip.Addr]bool, len(parts))
+	for _, part := range parts {
+		addr, err := netip.ParseAddr(part)
+		if err != nil || addr.Zone() != "" || !reviewed[addr.Unmap()] || allowed[addr.Unmap()] {
+			return nil, fmt.Errorf("invalid or unreviewed webhook API server IP")
+		}
+		allowed[addr.Unmap()] = true
+	}
+	return allowed, nil
+}
