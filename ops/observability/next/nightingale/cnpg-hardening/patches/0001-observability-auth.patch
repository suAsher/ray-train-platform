+// healthResponse records only the status; internal probe details remain in upstream logs.
+type healthResponse struct {
+	header http.Header
+	status int
+}
+
+func (w *healthResponse) Header() http.Header { return w.header }
+
+func (w *healthResponse) WriteHeader(status int) {
+	if w.status == 0 {
+		w.status = status
+	}
+}
+
+func (w *healthResponse) Write(body []byte) (int, error) {
+	if w.status == 0 {
+		w.status = http.StatusOK
+	}
+	return len(body), nil
+}
+
+func withMinimalHealthResponse(next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		response := &healthResponse{header: make(http.Header)}
+		next(response, r)
+		if response.status == 0 {
+			response.status = http.StatusOK
+		}
+		if response.status != http.StatusOK {
+			http.Error(w, "unhealthy", response.status)
+			return
+		}
+		w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+		w.WriteHeader(http.StatusOK)
+		_, _ = fmt.Fprint(w, "OK")
 	}
 }
 
