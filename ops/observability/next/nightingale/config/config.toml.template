[Global]
RunMode = "release"
[Log]
Dir = "/var/log/n9e"
Level = "INFO"
Output = "stdout"
[HTTP]
Host = "127.0.0.1"
Port = 17000
PrintAccessLog = false
PProf = false
ExposeMetrics = true
ShutdownTimeout = 30
MaxContentLength = 8388608
ReadTimeout = 20
WriteTimeout = 40
IdleTimeout = 120
[HTTP.ShowCaptcha]
Enable = true
[HTTP.APIForAgent]
Enable = false
[HTTP.APIForService]
Enable = false
[HTTP.JWTAuth]
AccessExpired = 60
RefreshExpired = 1440
RedisKeyPrefix = "/jwt/"
[HTTP.ProxyAuth]
Enable = false
[HTTP.TokenAuth]
Enable = true
[HTTP.A2A]
Disable = true
DisableMCP = true
MCPEnableWriteTools = false
[DB]
DBType = "postgres"
DSN = @@DB_DSN@@
Debug = false
MaxLifetime = 600
MaxOpenConns = 20
MaxIdleConns = 5
[Redis]
UseTLS = true
TLSCA = "/etc/n9e-redis-mtls/ca.crt"
TLSCert = "/etc/n9e-redis-mtls/tls.crt"
TLSKey = "/etc/n9e-redis-mtls/tls.key"
InsecureSkipVerify = false
ServerName = ""
TLSMinVersion = "1.3"
RedisType = "sentinel"
Address = "nightingale-redis-announce-0.nightingale.svc:26379,nightingale-redis-announce-1.nightingale.svc:26379,nightingale-redis-announce-2.nightingale.svc:26379"
Password = @@REDIS_PASSWORD@@
SentinelPassword = @@SENTINEL_PASSWORD@@
MasterName = "n9e"
DB = 0
[Alert.Heartbeat]
IP = @@POD_IP@@
Interval = 1000
EngineName = "vke-additive-canary"
[Alert.EvalLog]
Disable = true
[Center]
MetricsYamlFile = "/run/n9e/etc/metrics.yaml"
CleanAlertHisEventDay = 30
[Center.AnonymousAccess]
PromQuerier = false
AlertDetail = false
[EmbeddedTSDB]
Enable = false
[Pushgw]
LabelRewrite = false
[Ibex]
Enable = false
